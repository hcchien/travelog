# 複製為 .env.local 後填入（.env.local 不進版控）

# ---- 資料庫：本機 PostgreSQL 16 以上，需安裝 postgis 與 pg_trgm（pgcrypto 為內建 contrib）
DATABASE_URL=postgres://localhost:5432/travelog
# packages/db 的整合測試使用；測試會清空這個資料庫
TEST_DATABASE_URL=postgres://localhost:5432/travelog_test

# ---- API
PORT=8080
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080
# 額外允許的前端 origin（逗號分隔）
EXTRA_ORIGINS=

# Passkey：本機用 localhost；正式環境用根網域（例如 travelog.app），定了之後不能改
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Travelog
WEBAUTHN_APP_ORIGINS=

# Google OAuth（GCP 主控台 → API 和服務 → 憑證 → OAuth 用戶端 ID，類型「網頁應用程式」）
# 已授權的重新導向 URI：http://localhost:8080/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS / Android 原生 Google Sign-In 的 client ID（逗號分隔）
GOOGLE_NATIVE_CLIENT_IDS=

# 簽章 cookie 用，至少 32 字元：openssl rand -base64 32
COOKIE_SECRET=

# ES256 私鑰（PKCS#8 PEM）。本機可留空，啟動時會產生暫時金鑰。
# 產生方式：openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
JWT_PRIVATE_KEY=
