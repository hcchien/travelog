{
  "name": "@travelog/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sandbox": "tsx sandbox/server.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@photostructure/tz-lookup": "^11.8.0",
    "@simplewebauthn/server": "^14.1.0",
    "@travelog/db": "workspace:*",
    "@travelog/domain": "workspace:*",
    "@travelog/schema": "workspace:*",
    "@travelog/tools": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-postgis": "0.2.17",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
